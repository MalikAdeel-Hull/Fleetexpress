# VRMS Driver Portal — environment variables
# Copy to ".env" (or set these in your shell / service manager) and adjust.

# Where the existing VRMS desktop app lives (the portal imports its models).
VRMS_APP_PATH=E:\vrms

# Database. Leave UNSET to use the desktop app's SQLite vrms.db (default).
# For production PostgreSQL, set this and install psycopg2-binary:
# DATABASE_URL=postgresql+psycopg2://vrms_user:secret@localhost:5432/vrms

# REQUIRED in production: a fixed secret so sessions survive restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Session idle timeout in minutes (default 30).
SESSION_TIMEOUT_MINUTES=30

# Set to 1 only when serving over HTTPS (marks the cookie Secure).
SESSION_COOKIE_SECURE=0

# Office contact details shown on the dashboard.
ADMIN_EMAIL=office@ecoexpress.example
ADMIN_PHONE=0000 000 0000

# Public marketing site the portal links back to ("Back to website" link).
# Use the full site URL in production, e.g. https://www.fleetexpress.co.uk/
SITE_URL=/
